---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import ToolBreakdown from '../../components/ToolBreakdown.astro';
import Changelog from '../../components/Changelog.astro';
import ReviewForm from '../../components/ReviewForm.astro';
import ComparisonDock from '../../components/ComparisonDock.astro';
import {
  alternativesPath,
  catalog,
  comparePath,
  getTopCompetitors,
  money,
  priceLabel,
  softwareSchema,
  toolPath,
  type CatalogTool,
} from '../../lib/catalog';
import { breadcrumbSchema } from '../../lib/seo';
import { REVIEWS_ENABLED, CONTACT_EMAIL } from '../../config/site';

export const getStaticPaths = (() => {
  return catalog.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}) satisfies GetStaticPaths;

interface Props {
  tool: CatalogTool;
}
const { tool } = Astro.props;
const path = toolPath(tool);
const year = new Date().getFullYear();

const alternatives = catalog.filter((t) => t.category === tool.category && t.slug !== tool.slug).slice(0, 3);
/** Top same-category rivals; each one has a generated `/compare/<a>-vs-<b>/` page. */
const competitors = getTopCompetitors(tool, 4);

const title = `${tool.name} Pricing, Pros & Cons ${year}: Hidden Limits & Alternatives`;
const description = `${tool.name}: ${tool.best_for_usecase}. Starting at ${tool.starting_price === 0 ? 'free' : money(tool.starting_price)}. Hidden limits, AI models, pros and cons.`;

const schema = [
  softwareSchema(tool),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: tool.name, path },
  ]),
];
---

<Layout {title} {description} {path} {schema}>
  <nav class="mb-4 text-sm text-slate-600" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center">
      <li><a href="/" class="flex min-h-11 min-w-11 items-center justify-center hover:underline">Home</a></li>
      <li aria-hidden="true" class="px-2">/</li>
      <li><span class="flex min-h-11 items-center">{tool.category}</span></li>
      <li aria-hidden="true" class="px-2">/</li>
      <li aria-current="page" class="flex min-h-11 items-center font-medium text-slate-800">{tool.name}</li>
    </ol>
  </nav>

  <ToolHeader {tool} />

  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <div class="space-y-6 lg:col-span-2">
      <ToolBreakdown {tool} />
      <Changelog {tool} />
    </div>

    <aside class="space-y-6" aria-label="Related">
      {
        alternatives.length > 0 && (
          <section class="rounded-3xl border border-slate-200 bg-white p-5" aria-labelledby="alts">
            <h2 id="alts" class="text-base font-semibold text-slate-900">Alternatives in {tool.category}</h2>
            <ul class="mt-2">
              {alternatives.map((a) => (
                <li>
                  <a href={toolPath(a)} class="flex min-h-14 items-center gap-3 rounded-xl px-1 hover:bg-slate-50">
                    <img src={a.logo} alt="" width="36" height="36" loading="lazy" class="size-9 rounded-lg" />
                    <span class="min-w-0">
                      <span class="block truncate text-sm font-semibold text-slate-900">{a.name}</span>
                      <span class="block text-xs text-slate-600">{priceLabel(a)}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <a href="/stack-builder/" class="flex min-h-11 items-center justify-center rounded-full border border-slate-300 bg-white px-5 text-sm font-semibold text-slate-800 hover:bg-slate-50">Add to a stack →</a>
    </aside>
  </div>

  <section aria-labelledby="compare-alts" class="mt-8 rounded-3xl border border-slate-200 bg-white p-5 sm:p-6">
    <h2 id="compare-alts" class="text-xl font-semibold text-slate-900">Compare &amp; alternatives</h2>
    <p class="mt-1 text-sm text-slate-700">See how {tool.name} stacks up against similar tools.</p>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
      <li>
        <a href={alternativesPath(tool)} class="flex min-h-11 items-center justify-between gap-2 rounded-2xl border border-indigo-200 bg-indigo-50 px-4 text-sm font-semibold text-indigo-800 hover:bg-indigo-100">
          Best {tool.name} alternatives <span aria-hidden="true">→</span>
        </a>
      </li>
      {
        competitors.map((c) => (
          <li>
            <a href={comparePath(tool, c)} class="flex min-h-11 items-center justify-between gap-2 rounded-2xl border border-slate-200 px-4 text-sm font-semibold text-slate-800 hover:bg-slate-50">
              {tool.name} vs {c.name} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="community" class="mt-8">
    <h2 id="community" class="text-xl font-semibold text-slate-900">Community reviews</h2>
    {
      REVIEWS_ENABLED ? (
        <div class="mt-3 grid gap-4 lg:grid-cols-2">
          <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-center">
            <p class="font-semibold text-slate-900">No community reviews yet</p>
            <p class="mt-1 text-sm text-slate-600">Be the first to share how {tool.name} works for you.</p>
          </div>
          <ReviewForm toolName={tool.name} />
        </div>
      ) : (
        <div class="mt-3 rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-center">
          <p class="font-semibold text-slate-900">Reviews aren't live yet</p>
          <p class="mt-1 text-sm text-slate-600">
            We're building this out. In the meantime,{' '}
            <a href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`${tool.name} feedback`)}`} class="font-medium text-indigo-700 hover:underline">
              email us your take on {tool.name}
            </a>.
          </p>
        </div>
      )
    }
  </section>

  <ComparisonDock />
</Layout>
