---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="The page you were looking for does not exist on Usaasly." path="/404/" noindex narrow>
  <h1 class="text-3xl font-bold tracking-tight text-slate-900">Page not found</h1>
  <p class="mt-3 text-slate-700">That page doesn't exist or has moved. Try one of these instead:</p>
  <ul class="mt-4 space-y-2 text-indigo-700">
    <li><a class="hover:underline" href="/">Browse all tools</a></li>
    <li><a class="hover:underline" href="/compare/">Compare tools</a></li>
    <li><a class="hover:underline" href="/stack-builder/">Stack builder</a></li>
  </ul>
</Layout>
