---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tools, allPairs, formatPrice } from '../lib/tools';
import { absoluteUrl } from '../lib/seo';

const pairs = allPairs();
const schema = [
  {
    '@type': 'WebSite',
    name: 'Usassly',
    url: absoluteUrl('/'),
  },
];
---

<BaseLayout
  title="SaaS Pricing Comparisons & Reviews"
  description="Up-to-date SaaS pricing, side-by-side comparisons and honest reviews, checked weekly."
  path="/"
  ogType="website"
  {schema}
>
  <h1 class="text-3xl font-bold tracking-tight">SaaS pricing, compared.</h1>
  <p class="mt-2 text-slate-600">Prices re-checked weekly. Pick a tool or a head-to-head comparison.</p>

  <h2 class="mt-8 text-xl font-semibold">Reviews</h2>
  <ul class="mt-3 grid gap-3 sm:grid-cols-2">
    {tools.map((t) => (
      <li class="rounded-lg border border-slate-200 bg-white p-4">
        <a href={`/review/${t.slug}/`} class="font-semibold text-indigo-600 hover:underline">{t.name}</a>
        <p class="text-sm text-slate-500">{formatPrice(t)} · {t.category}</p>
      </li>
    ))}
  </ul>

  <h2 class="mt-8 text-xl font-semibold">Comparisons</h2>
  <ul class="mt-3 grid gap-2 sm:grid-cols-2">
    {pairs.map((p) => (
      <li>
        <a href={`/compare/${p.slug}/`} class="text-indigo-600 hover:underline">{p.a.name} vs {p.b.name}</a>
      </li>
    ))}
  </ul>
</BaseLayout>
