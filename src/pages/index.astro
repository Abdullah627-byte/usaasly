---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CategoryPills from '../components/CategoryPills.astro';
import ToolCard from '../components/ToolCard.astro';
import ComparisonDock from '../components/ComparisonDock.astro';
import QuizDialog from '../components/QuizDialog.astro';
import { alternativesPath, catalog, categories, categoryPairs, toLite, toolPath } from '../lib/catalog';
import { jsonLdString, absoluteUrl } from '../lib/seo';
import { tools as pseoTools } from '../lib/tools';

const lite = catalog.map(toLite);
const counts = Object.fromEntries(categories.map((c) => [c, catalog.filter((t) => t.category === c).length]));

const schema = [
  {
    '@type': 'CollectionPage',
    name: 'SaaS & AI tool directory',
    url: absoluteUrl('/'),
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: catalog.length,
      itemListElement: catalog.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.name,
        url: absoluteUrl(toolPath(t)),
      })),
    },
  },
];

// Long-form pSEO pages (only those with generated content are indexable).
const reviews = pseoTools.filter((t) => t.content);
// Popular head-to-heads: the highest-rated same-category pairs.
const pairs = categoryPairs()
  .sort((x, y) => y.a.rating + y.b.rating - (x.a.rating + x.b.rating) || x.slug.localeCompare(y.slug))
  .slice(0, 12);
const topTools = [...catalog].sort((x, y) => y.rating - x.rating || x.name.localeCompare(y.name)).slice(0, 8);
---

<Layout
  title="Best SaaS & AI Tools: Compare Pricing, Limits & Real Costs"
  description="Compare 50 SaaS and AI tools side by side: real pricing, hidden limits, AI models and open-source options. Find your perfect tool in 30 seconds."
  path="/"
  {schema}
>
  <Hero total={catalog.length} />
  <CategoryPills {categories} {counts} total={catalog.length} />

  <div class="mt-4 flex items-center justify-between">
    <h2 class="text-lg font-semibold text-slate-900">All tools</h2>
    <p id="result-count" class="text-sm text-slate-600" aria-live="polite">{catalog.length} tools</p>
  </div>

  <ul id="tool-grid" class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {catalog.map((t) => <ToolCard tool={t} />)}
  </ul>

  <div id="empty-state" hidden class="mt-6 rounded-3xl border border-dashed border-slate-300 bg-white p-10 text-center">
    <p class="text-lg font-semibold text-slate-900">No tools match your filters</p>
    <p class="mt-1 text-sm text-slate-600">Try a different search or category, or switch off the open-source / free-only toggle.</p>
    <button type="button" id="reset-filters" class="mt-4 min-h-11 rounded-full border border-slate-300 px-5 text-sm font-semibold text-slate-800 hover:bg-slate-50">Reset search &amp; category</button>
  </div>

  <nav aria-label="In-depth guides" class="mt-12 rounded-3xl border border-slate-200 bg-white p-5">
    <h2 class="text-lg font-semibold text-slate-900">Popular comparisons &amp; alternatives</h2>
    <ul class="mt-2 flex flex-wrap gap-x-4">
      {topTools.map((t) => (
        <li><a href={alternativesPath(t)} class="flex min-h-11 items-center text-sm font-medium text-indigo-700 hover:underline">{t.name} alternatives</a></li>
      ))}
      {reviews.map((t) => (
        <li><a href={`/review/${t.slug}/`} class="flex min-h-11 items-center text-sm font-medium text-indigo-700 hover:underline">{t.name} review</a></li>
      ))}
      {pairs.map((p) => (
        <li><a href={`/compare/${p.slug}/`} class="flex min-h-11 items-center text-sm font-medium text-indigo-700 hover:underline">{p.a.name} vs {p.b.name}</a></li>
      ))}
    </ul>
  </nav>

  <ComparisonDock />
  <QuizDialog />
  <script type="application/json" id="catalog-lite" set:html={jsonLdString(lite)} />
  <script>
    import '../scripts/home';
  </script>
</Layout>
