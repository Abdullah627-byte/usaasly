---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusNotice from '../../components/StatusNotice.astro';
import { allPairs, formatPrice, type Pair } from '../../lib/tools';
import { absoluteUrl, breadcrumbSchema, faqSchema } from '../../lib/seo';

export const getStaticPaths = (() => {
  return allPairs().map((pair) => ({ params: { slug: pair.slug }, props: { pair } }));
}) satisfies GetStaticPaths;

interface Props {
  pair: Pair;
}
const { pair } = Astro.props;
const { a, b, content: c } = pair;
const year = new Date().getFullYear();
const path = `/compare/${pair.slug}/`;

const title = `${a.name} vs ${b.name} (${year}): Pricing & Features Compared`;
const description = c
  ? `${a.name} vs ${b.name}: ${c.intro}`
  : `${a.name} (${formatPrice(a)}) vs ${b.name} (${formatPrice(b)}) — side-by-side pricing and features.`;

const winnerName = c ? (c.winner === a.slug ? a.name : c.winner === b.slug ? b.name : null) : null;

const itemSchema = (t: typeof a) => ({
  '@type': 'Product',
  name: t.name,
  url: absoluteUrl(`/review/${t.slug}/`),
  category: t.category,
  ...(t.current_price !== null && {
    offers: {
      '@type': 'Offer',
      price: t.current_price,
      priceCurrency: t.currency,
      url: t.official_pricing_url,
    },
  }),
});

const schema: Record<string, unknown>[] = [
  {
    '@type': 'WebPage',
    '@id': `${absoluteUrl(path)}#webpage`,
    name: title,
    url: absoluteUrl(path),
    about: [itemSchema(a), itemSchema(b)],
  },
  {
    '@type': 'ItemList',
    name: `${a.name} vs ${b.name}`,
    itemListElement: [a, b].map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: itemSchema(t),
    })),
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: `${a.name} vs ${b.name}`, path },
  ]),
];
if (c?.faqs?.length) schema.push(faqSchema(c.faqs));
---

<BaseLayout {title} {description} {path} {schema} noindex={!c}>
  <nav class="mb-4 text-sm text-slate-500" aria-label="Breadcrumb">
    <a href="/" class="hover:underline">Home</a> / <span>{a.name} vs {b.name}</span>
  </nav>

  <StatusNotice tools={[a, b]} />

  <h1 class="text-3xl font-bold tracking-tight text-slate-900">{a.name} vs {b.name} ({year})</h1>
  {c && <p class="mt-2 text-lg text-slate-600">{c.intro}</p>}

  <section class="mt-6 grid gap-4 sm:grid-cols-2">
    {[a, b].map((t) => (
      <div class="rounded-xl border border-slate-200 bg-white p-5">
        <h2 class="text-lg font-semibold">
          <a href={`/review/${t.slug}/`} class="hover:underline">{t.name}</a>
        </h2>
        <p class="mt-1 text-2xl font-bold text-indigo-600">{formatPrice(t)}</p>
        <p class="text-sm text-slate-500">{t.price_unit}</p>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm">
          {t.plan_features.map((f) => <li>{f}</li>)}
        </ul>
        <a
          href={t.official_pricing_url}
          rel="nofollow noopener"
          target="_blank"
          class="mt-4 inline-block text-sm font-semibold text-indigo-600 hover:underline"
        >
          Official pricing →
        </a>
      </div>
    ))}
  </section>

  {c?.rows?.length ? (
    <section class="mt-8">
      <h2 class="text-xl font-semibold">Head-to-head</h2>
      <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-100 text-slate-600">
            <tr>
              <th class="p-3">Category</th>
              <th class="p-3">{a.name}</th>
              <th class="p-3">{b.name}</th>
            </tr>
          </thead>
          <tbody>
            {c.rows.map((r) => (
              <tr class="border-t border-slate-100">
                <td class="p-3 font-medium">{r.category}</td>
                <td class:list={['p-3', r.winner === 'a' && 'bg-emerald-50 font-semibold']}>{r.a}</td>
                <td class:list={['p-3', r.winner === 'b' && 'bg-emerald-50 font-semibold']}>{r.b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ) : null}

  {c && (
    <section class="mt-8">
      <h2 class="text-xl font-semibold">
        Verdict{winnerName ? `: ${winnerName} wins` : ': it depends'}
      </h2>
      <p class="mt-2 leading-relaxed">{c.verdict}</p>
    </section>
  )}

  {c?.faqs?.length ? (
    <section class="mt-8">
      <h2 class="text-xl font-semibold">FAQ</h2>
      <div class="mt-2 space-y-4">
        {c.faqs.map((f) => (
          <div>
            <h3 class="font-medium">{f.question}</h3>
            <p class="text-slate-600">{f.answer}</p>
          </div>
        ))}
      </div>
    </section>
  ) : null}
</BaseLayout>
