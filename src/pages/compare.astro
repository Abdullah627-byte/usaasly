---
import Layout from '../layouts/Layout.astro';
import { catalog } from '../lib/catalog';
import { jsonLdString, breadcrumbSchema } from '../lib/seo';

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Compare tools', path: '/compare/' },
  ]),
];
---

<Layout
  title="Compare SaaS & AI Tools Side by Side (Up to 6) + Real Cost Calculator"
  description="Compare up to 6 SaaS and AI tools side by side: exact pricing, hidden limits, AI models, use cases, pros and cons. Calculate your real monthly cost by team size."
  path="/compare/"
  {schema}
>
  <h1 class="text-3xl font-bold tracking-tight text-slate-900">Compare tools</h1>
  <p class="mt-1 text-slate-600">Side-by-side matrix for up to 6 tools, with a real-cost calculator for your team size.</p>

  <section id="compare-empty" hidden class="mt-8 min-h-[50dvh] rounded-3xl border border-dashed border-slate-300 bg-white p-10 text-center">
    <p class="text-lg font-semibold text-slate-900">No tools selected yet</p>
    <p class="mt-1 text-sm text-slate-600">Pick tools with “+ Compare” on the home page, or add them below.</p>
    <a href="/" class="mt-4 inline-flex min-h-11 items-center rounded-full bg-indigo-700 px-5 text-sm font-semibold text-white hover:bg-indigo-800">Browse tools</a>
  </section>

  <div id="compare-filled" hidden class="min-h-[90dvh]">
    <section aria-labelledby="calc-title" class="mt-6 rounded-3xl border border-slate-200 bg-white p-5">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="calc-title" class="text-lg font-semibold text-slate-900">Real Cost Calculator</h2>
          <p class="text-sm text-slate-600">Per-user tools are multiplied by your team size. Flat-fee tools stay the same.</p>
        </div>
        <p class="text-sm font-semibold text-slate-800">Team size: <span id="team-label" class="text-indigo-700">5 users</span></p>
      </div>

      <div class="mt-4 flex items-center gap-4">
        <label for="team-slider" class="sr-only">Team size (1 to 100)</label>
        <input id="team-slider" type="range" min="1" max="100" step="1" value="5" class="h-11 min-w-0 flex-1 cursor-pointer" />
        <label for="team-number" class="sr-only">Team size number</label>
        <input id="team-number" type="number" inputmode="numeric" min="1" max="100" value="5" class="h-11 w-20 rounded-xl border border-slate-300 bg-white px-3 text-center text-base font-semibold text-slate-900" />
      </div>
      <p id="compare-live" class="sr-only" aria-live="polite"></p>
    </section>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <label for="add-tool" class="sr-only">Add a tool to compare</label>
        <select id="add-tool" class="h-11 max-w-full rounded-full border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-800 disabled:text-slate-600"></select>
        <p id="compare-count" class="text-sm text-slate-600"></p>
      </div>
      <div class="flex gap-2">
        <button type="button" id="share-link" class="min-h-11 rounded-full border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-800 hover:bg-slate-50">Copy link</button>
        <button type="button" id="clear-all" class="min-h-11 rounded-full border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-800 hover:bg-slate-50">Clear all</button>
      </div>
    </div>

    <p class="mt-3 text-xs text-slate-600 sm:hidden">Swipe sideways to see every tool.</p>
    <div
      class="relative mt-2 max-h-[80dvh] overflow-auto rounded-3xl border border-slate-200 bg-white"
      tabindex="0"
      role="region"
      aria-label="Comparison table (scrollable)"
    >
      <div id="matrix"></div>
    </div>
  </div>

  <script type="application/json" id="catalog-full" set:html={jsonLdString(catalog)} />
  <script>
    import '../scripts/compare';
  </script>
</Layout>
