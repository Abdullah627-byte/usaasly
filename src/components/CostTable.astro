---
import { money, type CatalogTool } from '../lib/catalog';
import { costLines, TEAM_SIZES, type PricingPageData } from '../lib/pricingPages';

interface Props {
  tool: CatalogTool;
  page: PricingPageData;
}
const { tool, page } = Astro.props;
const lines = costLines(page.cost.rows);
---

<section aria-labelledby="real-cost" class="rounded-3xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 id="real-cost" class="text-xl font-semibold text-slate-900">What {tool.name} really costs</h2>
  <p class="mt-2 text-sm leading-relaxed text-slate-700">{page.cost.intro}</p>

  <div class="mt-4 overflow-x-auto">
    <table class="w-full min-w-[34rem] text-left text-sm">
      <thead>
        <tr class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-600">
          <th scope="col" class="py-2 pr-3 font-semibold">Plan and billing</th>
          {TEAM_SIZES.map((n) => <th scope="col" class="py-2 pr-3 font-semibold">{n} {n === 1 ? 'user' : 'users'}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          lines.map((l) => (
            <tr class="border-b border-slate-100 align-top">
              <th scope="row" class="py-2.5 pr-3 font-medium text-slate-900">
                {l.label}
                <span class="block text-xs font-normal text-slate-600">{l.billing}</span>
              </th>
              {l.values.map((v) => <td class="py-2.5 pr-3 font-semibold text-slate-900">{v === null ? <span class="font-normal text-slate-600">Not verified</span> : l.billing.startsWith('first year') ? money(v) : `${money(v)}/mo`}</td>)}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="mt-2 text-xs text-slate-600">Totals multiply the verified price by the number of people and assume everyone is on that plan. Taxes and add-ons are not included.</p>

  <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-slate-700">
    {page.cost.extras.map((e) => <li>{e}</li>)}
  </ul>
</section>
