---
import { alternativesPath, catalog, comparePath, getCatalogTool, toolPath, type CatalogTool } from '../lib/catalog';
import type { PricingPageData } from '../lib/pricingPages';

interface Props {
  tool: CatalogTool;
  page: PricingPageData;
}
const { tool, page } = Astro.props;

const compareWith = page.links.compare.map((s) => getCatalogTool(s)).filter((t): t is CatalogTool => Boolean(t));
---

<section aria-labelledby="worth-it" class="rounded-3xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 id="worth-it" class="text-xl font-semibold text-slate-900">Is {tool.name} worth it?</h2>
  <p class="mt-2 text-sm leading-relaxed text-slate-700">{page.verdict.worth}</p>

  <h3 class="mt-4 text-base font-semibold text-slate-900">Who should skip it</h3>
  <ul class="mt-2 list-disc space-y-2 pl-5 text-sm leading-relaxed text-slate-700">
    {page.verdict.skip.map((s) => <li>{s}</li>)}
  </ul>

  <h3 class="mt-4 text-base font-semibold text-slate-900">Free or cheaper options</h3>
  <p class="mt-2 text-sm leading-relaxed text-slate-700">{page.verdict.cheaper}</p>
  <ul class="mt-3 flex flex-wrap gap-2">
    <li>
      <a href={alternativesPath(tool)} class="flex min-h-11 items-center rounded-full border border-indigo-200 bg-indigo-50 px-4 text-sm font-semibold text-indigo-800 hover:bg-indigo-100">
        Best {tool.name} alternatives →
      </a>
    </li>
    {
      compareWith.map((c) => (
        <li>
          <a href={comparePath(tool, c)} class="flex min-h-11 items-center rounded-full border border-slate-200 px-4 text-sm font-semibold text-slate-800 hover:bg-slate-50">
            {tool.name} vs {c.name} →
          </a>
        </li>
      ))
    }
  </ul>
</section>
