---
import { SITE_NAME, CONTACT_EMAIL, AFFILIATE_LINKS } from '../config/site';

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Tools', href: '/' },
      { label: 'Compare', href: '/compare/' },
      { label: 'Stack Builder', href: '/stack-builder/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Methodology', href: '/methodology/' },
      { label: 'Contact', href: '/contact/' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Terms', href: '/terms/' },
    ],
  },
];

const submitToolHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Submit a tool')}`;
const linkClass = 'flex min-h-11 items-center rounded-lg text-sm text-slate-600 hover:text-slate-900';
---

<footer class="mt-12 border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <h2 class="text-sm font-semibold text-slate-900">{col.title}</h2>
            <ul class="mt-3 space-y-1">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class={linkClass}>
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <nav aria-label="Community">
        <h2 class="text-sm font-semibold text-slate-900">Community</h2>
        <ul class="mt-3 space-y-1">
          <li>
            <a href={submitToolHref} class={linkClass}>Submit a tool</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-8 border-t border-slate-200 pt-6 text-sm text-slate-600">
      <p>Prices change often. Confirm on the vendor's official page.</p>
      {AFFILIATE_LINKS && (
        <p class="mt-1">Some links on this site are affiliate links; we may earn a commission at no extra cost to you.</p>
      )}
      <p class="mt-3">© {new Date().getFullYear()} {SITE_NAME}.</p>
    </div>
  </div>
</footer>
