---
import { priceLabel, toolPath, type CatalogTool } from '../lib/catalog';

interface Props {
  tool: CatalogTool;
}
const { tool } = Astro.props;
const free = tool.is_open_source || tool.starting_price === 0;
const searchText = [tool.name, tool.category, tool.best_for_usecase, tool.ai_model, tool.is_open_source ? 'open source' : '', tool.has_free_tier ? 'free' : '']
  .join(' ')
  .toLowerCase();
---

<li
  data-card
  data-slug={tool.slug}
  data-cat={tool.category}
  data-free={String(free)}
  data-search={searchText}
  class="flex flex-col rounded-3xl border border-slate-200 bg-white p-5 transition-shadow hover:shadow-md"
>
  <div class="flex items-start gap-3">
    <img src={tool.logo} alt="" width="48" height="48" loading="lazy" decoding="async" class="size-12 shrink-0 rounded-xl" />
    <div class="min-w-0 flex-1">
      <h3 class="truncate text-base font-semibold text-slate-900">
        <a href={toolPath(tool)} class="-my-1 flex min-h-11 items-center rounded-lg">{tool.name}</a>
      </h3>
      <p class="-mt-1 truncate text-sm text-slate-600">{tool.category}</p>
    </div>
    <p class="flex shrink-0 items-center gap-1 text-sm font-semibold text-slate-800" aria-label={`Rated ${tool.rating} out of 5`}>
      <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 fill-amber-500"><path d="m10 1.5 2.6 5.5 6 .8-4.4 4.2 1.1 6-5.3-2.9-5.3 2.9 1.1-6L1.4 7.8l6-.8L10 1.5Z"></path></svg>
      {tool.rating.toFixed(1)}
    </p>
  </div>

  <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-slate-700">{tool.best_for_usecase}</p>

  <div class="mt-3 flex flex-wrap gap-2">
    <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-800">{priceLabel(tool)}</span>
    {tool.is_open_source && <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-800">Open source</span>}
    {tool.has_free_tier && !tool.is_open_source && <span class="rounded-full bg-sky-50 px-2.5 py-1 text-xs font-medium text-sky-800">Free tier</span>}
  </div>

  <div class="mt-auto flex items-center justify-between gap-2 pt-4">
    <a href={toolPath(tool)} class="flex min-h-11 items-center rounded-full px-3 text-sm font-semibold text-indigo-700 hover:bg-indigo-50">
      Details<span class="sr-only">: {tool.name}</span>
    </a>
    <button
      type="button"
      data-compare-toggle={tool.slug}
      data-name={tool.name}
      aria-pressed="false"
      class="min-h-11 rounded-full border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-800 hover:border-slate-400 hover:bg-slate-50 aria-pressed:border-indigo-700 aria-pressed:bg-indigo-700 aria-pressed:text-white"
    >
      <span data-label>+ Compare</span><span class="sr-only"> {tool.name}</span>
    </button>
  </div>
</li>
