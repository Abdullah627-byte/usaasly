---
import { money, priceText, toolPath, type CatalogTool } from '../lib/catalog';

interface Props {
  a: CatalogTool;
  b: CatalogTool;
}
const { a, b } = Astro.props;
const tools = [a, b];

/** Cost at the listed starting plan for n people. Per-user tools scale, flat-priced tools do not. */
const cost = (t: CatalogTool, n: number) => (t.starting_price === 0 ? 0 : t.price_per_user ? Math.round(t.starting_price * n * 100) / 100 : t.starting_price);
const fmt = (n: number) => (n === 0 ? 'Free' : `${money(n)}/mo`);
const sizes = [1, 5, 25];

const cheap25 = cost(a, 25) === cost(b, 25) ? null : cost(a, 25) < cost(b, 25) ? a : b;
const lines: string[] = [];
lines.push(`${a.name} is ${priceText(a)} and ${b.name} is ${priceText(b)}.`);
if (a.price_per_user !== b.price_per_user && a.starting_price > 0 && b.starting_price > 0) {
  const flat = a.price_per_user ? b : a;
  const seat = a.price_per_user ? a : b;
  lines.push(`${seat.name} is priced per person while ${flat.name} lists a flat price, so the gap changes with team size.`);
}
if (cheap25) lines.push(`For a team of 25 on the starting plans, ${cheap25.name} comes out cheaper (${fmt(cost(cheap25, 25))} against ${fmt(cost(cheap25 === a ? b : a, 25))}).`);
if (a.has_free_tier !== b.has_free_tier) {
  const free = a.has_free_tier ? a : b;
  lines.push(`Only ${free.name} has a free plan, so it is the safer one to try first.`);
} else if (a.has_free_tier && b.has_free_tier) {
  lines.push('Both have a free plan, so you can test each before paying.');
}
---

<section class="mt-8 rounded-3xl border border-slate-200 bg-white p-5 sm:p-6" aria-labelledby="verdict-title">
  <h2 id="verdict-title" class="text-xl font-semibold text-slate-900">What it costs as your team grows</h2>
  <p class="mt-1 text-sm text-slate-600">Starting plans only, USD, before tax. This assumes every person needs the plan listed.</p>
  <div class="mt-3 overflow-x-auto">
    <table class="w-full min-w-[22rem] text-left text-sm">
      <thead>
        <tr class="border-b border-slate-200 text-slate-600">
          <th scope="col" class="py-2 pr-3 font-semibold">Team size</th>
          {tools.map((t) => <th scope="col" class="py-2 pr-3 font-semibold">{t.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          sizes.map((n) => (
            <tr class="border-b border-slate-100">
              <th scope="row" class="py-2 pr-3 font-medium text-slate-800">{n} {n === 1 ? 'person' : 'people'}</th>
              {tools.map((t) => <td class="py-2 pr-3 text-slate-800">{fmt(cost(t, n))}</td>)}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h3 class="mt-6 text-base font-semibold text-slate-900">Bottom line</h3>
  <p class="mt-1 text-sm leading-relaxed text-slate-700">{lines.join(' ')}</p>

  <h3 class="mt-5 text-base font-semibold text-slate-900">Limits to check before you commit</h3>
  <ul class="mt-2 space-y-3 text-sm leading-relaxed text-slate-700">
    {
      tools.map((t) => (
        <li>
          <a href={toolPath(t)} class="font-semibold text-indigo-700 hover:underline">{t.name}</a>: {t.hidden_limits}
        </li>
      ))
    }
  </ul>

  <h3 class="mt-5 text-base font-semibold text-slate-900">AI models</h3>
  <p class="mt-1 text-sm leading-relaxed text-slate-700">
    {a.name} uses {a.ai_model}. {b.name} uses {b.ai_model}. Which models you get depends on the plan, so check the tier you plan to buy.
  </p>
</section>
