---
import type { CatalogTool } from '../lib/catalog';

interface Props {
  tool: CatalogTool;
}
const { tool } = Astro.props;

// UI placeholder: no fabricated release notes, just what the editorial team will track.
const entries = [
  { label: 'Pricing checks', text: `We verify ${tool.name}'s starting price against its official pricing page.` },
  { label: 'Feature updates', text: `New ${tool.name} releases and plan changes will be summarized here.` },
  { label: 'AI model changes', text: `We track which AI models power ${tool.name} (currently: ${tool.ai_model}).` },
];
---

<section aria-labelledby="changelog" class="rounded-3xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 id="changelog" class="text-xl font-semibold text-slate-900">Recent updates &amp; changelog</h2>
  <p class="mt-1 text-sm text-slate-600">A live changelog is coming soon. Here is what we will track for {tool.name}:</p>
  <ol class="mt-4 space-y-4 border-l-2 border-slate-200 pl-5">
    {
      entries.map((c) => (
        <li class="relative">
          <span aria-hidden="true" class="absolute -left-[1.6rem] top-1.5 size-3 rounded-full border-2 border-white bg-slate-400" />
          <p class="text-sm font-semibold text-slate-900">
            {c.label} <span class="ml-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">Coming soon</span>
          </p>
          <p class="text-sm text-slate-700">{c.text}</p>
        </li>
      ))
    }
  </ol>
</section>
