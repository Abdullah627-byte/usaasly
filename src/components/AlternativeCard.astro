---
import { comparePath, priceLabel, toolPath, type CatalogTool } from '../lib/catalog';
import { SHOW_RATINGS } from '../config/site';

interface Props {
  tool: CatalogTool;
  /** The tool the page is about (used for the "A vs B" link). */
  base: CatalogTool;
  rank: number;
}
const { tool: t, base, rank } = Astro.props;
const sameCategory = t.category === base.category;
---

<li class="flex flex-col rounded-3xl border border-slate-200 bg-white p-5">
  <div class="flex items-start gap-3">
    <img src={t.logo} alt={`${t.name} logo`} width="48" height="48" loading="lazy" class="size-12 shrink-0 rounded-xl" />
    <div class="min-w-0 flex-1">
      <p class="text-xs font-semibold text-slate-600">#{rank}{sameCategory ? '' : ` · ${t.category}`}</p>
      <h2 class="text-lg font-semibold text-slate-900">
        <a href={toolPath(t)} class="hover:underline">{t.name}</a>
      </h2>
    </div>
    {SHOW_RATINGS && <p class="text-sm font-semibold text-slate-800">★ {t.rating.toFixed(1)}</p>}
  </div>

  <div class="mt-3 flex flex-wrap gap-2">
    <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-800">{priceLabel(t)}</span>
    {t.is_open_source && <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-800">Open source</span>}
    {t.has_free_tier && !t.is_open_source && <span class="rounded-full bg-sky-50 px-2.5 py-1 text-xs font-medium text-sky-800">Free tier</span>}
  </div>

  <p class="mt-3 text-sm leading-relaxed text-slate-700">{t.best_for_usecase}</p>

  <h3 class="mt-3 text-xs font-semibold uppercase tracking-wide text-slate-600">Key strengths</h3>
  <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-slate-800">
    {t.pros.slice(0, 3).map((p) => <li>{p}</li>)}
  </ul>

  <div class="mt-auto flex flex-wrap items-center gap-2 pt-4">
    <a href={toolPath(t)} class="flex min-h-11 items-center rounded-full border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-800 hover:bg-slate-50">
      Details<span class="sr-only">: {t.name}</span>
    </a>
    <a
      href={t.website_url}
      target="_blank"
      rel="noopener nofollow"
      class="flex min-h-11 items-center rounded-full bg-indigo-700 px-4 text-sm font-semibold text-white hover:bg-indigo-800"
    >
      Visit {t.name}<span class="sr-only"> (opens in a new tab)</span> ↗
    </a>
    {
      sameCategory && (
        <a href={comparePath(base, t)} class="flex min-h-11 items-center text-sm font-medium text-indigo-700 hover:underline">
          {base.name} vs {t.name}
        </a>
      )
    }
  </div>
</li>
