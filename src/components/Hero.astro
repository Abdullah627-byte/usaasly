---
interface Props {
  total: number;
}
const { total } = Astro.props;
---

<section class="mx-auto max-w-3xl pb-8 pt-4 text-center sm:pt-10" aria-labelledby="hero-title">
  <h1 id="hero-title" class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Find the right SaaS tool.</h1>
  <p class="mx-auto mt-3 max-w-xl text-lg text-slate-600">
    {total} SaaS &amp; AI tools with real pricing, hidden limits and honest pros and cons.
  </p>

  <form role="search" class="relative mt-8" onsubmit="return false">
    <label for="search" class="sr-only">Search tools</label>
    <svg aria-hidden="true" viewBox="0 0 20 20" class="pointer-events-none absolute left-5 top-1/2 size-5 -translate-y-1/2 fill-none stroke-slate-500" stroke-width="2" stroke-linecap="round">
      <circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m13 13 4 4"></path>
    </svg>
    <input
      id="search"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search tools, categories or use cases…"
      aria-controls="tool-grid"
      aria-keyshortcuts="Control+K Meta+K"
      class="h-14 w-full rounded-full border border-slate-300 bg-white pl-12 pr-28 text-base text-slate-900 shadow-sm placeholder:text-slate-500 hover:shadow-md [&::-webkit-search-cancel-button]:appearance-none"
    />
    <button
      type="button"
      id="search-clear"
      hidden
      aria-label="Clear search"
      class="absolute right-4 top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-full text-xl text-slate-600 hover:bg-slate-100 sm:right-20"
    >
      ×
    </button>
    <kbd
      data-kbd
      aria-hidden="true"
      class="pointer-events-none absolute right-4 top-1/2 hidden -translate-y-1/2 rounded-lg border border-slate-300 bg-slate-50 px-2 py-1 font-sans text-xs font-semibold text-slate-600 sm:block"
    >⌘K</kbd>
  </form>

  <div class="mt-5 flex flex-col items-center justify-center gap-3 sm:flex-row">
    <button
      type="button"
      data-open-quiz
      class="flex min-h-12 items-center gap-2 rounded-full bg-indigo-700 px-6 text-base font-semibold text-white shadow-sm hover:bg-indigo-800"
    >
      <span aria-hidden="true">✨</span> Find My Perfect Tool
    </button>
    <a href="/stack-builder/" class="flex min-h-12 items-center rounded-full border border-slate-300 bg-white px-6 text-base font-semibold text-slate-800 hover:bg-slate-50">
      Build my stack
    </a>
  </div>
</section>
