---
import type { CatalogTool } from '../lib/catalog';
import { SHOW_RATINGS } from '../config/site';

interface Props {
  tool: CatalogTool;
}
const { tool } = Astro.props;
---

<header class="rounded-3xl border border-slate-200 bg-white p-5 sm:p-8">
  <div class="flex flex-wrap items-start gap-4">
    <img src={tool.logo} alt={`${tool.name} logo`} width="72" height="72" class="size-[72px] rounded-2xl" />
    <div class="min-w-0 flex-1">
      <p class="text-sm font-medium text-indigo-700">{tool.category}</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">{tool.name}</h1>
      <p class="mt-1 text-slate-700">{tool.best_for_usecase}</p>
      <div class="mt-3 flex flex-wrap gap-2 text-xs font-medium">
        {tool.is_open_source && <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-emerald-800">Open source</span>}
        {tool.has_free_tier && <span class="rounded-full bg-sky-50 px-2.5 py-1 text-sky-800">Free tier available</span>}
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-slate-800">{tool.price_per_user ? 'Per-user pricing' : 'Flat pricing'}</span>
      </div>
    </div>
    {
      SHOW_RATINGS && (
        <div class="text-right">
          <p class="text-sm text-slate-600">Our rating</p>
          <p class="text-3xl font-bold text-slate-900">{tool.rating.toFixed(1)}<span class="text-base font-normal text-slate-600"> / 5</span></p>
        </div>
      )
    }
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a href={tool.website_url} target="_blank" rel="noopener nofollow" class="flex min-h-11 items-center rounded-full bg-indigo-700 px-6 text-sm font-semibold text-white hover:bg-indigo-800">
      Visit {tool.name}<span class="sr-only"> (opens in a new tab)</span> ↗
    </a>
    <button type="button" data-compare-toggle={tool.slug} data-name={tool.name} aria-pressed="false" class="min-h-11 rounded-full border border-slate-300 bg-white px-5 text-sm font-semibold text-slate-800 hover:bg-slate-50 aria-pressed:border-indigo-700 aria-pressed:bg-indigo-700 aria-pressed:text-white">
      <span data-label>+ Compare</span><span class="sr-only"> {tool.name}</span>
    </button>
  </div>
</header>
