---
import type { CatalogTool } from '../lib/catalog';
import type { PricingPageData } from '../lib/pricingPages';

interface Props {
  tool: CatalogTool;
  page: PricingPageData;
}
const { tool, page } = Astro.props;
---

<section aria-labelledby="faq-title" class="rounded-3xl border border-slate-200 bg-white p-5 sm:p-6">
  <h2 id="faq-title" class="text-xl font-semibold text-slate-900">{tool.name} pricing questions answered</h2>
  <div class="mt-4 space-y-5">
    {
      page.faqs.map((f) => (
        <div>
          <h3 class="text-base font-semibold text-slate-900">{f.q}</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-700">{f.a}</p>
        </div>
      ))
    }
  </div>
</section>
