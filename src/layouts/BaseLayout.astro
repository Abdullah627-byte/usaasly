---
/**
 * Wrapper kept for the programmatic-SEO pages (/review/*, /compare/<a>-vs-<b>/)
 * so they share the global header, Free-Only toggle and SEO markup of Layout.astro.
 */
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { ogType = 'article', ...rest } = Astro.props;
---

<Layout {...rest} {ogType} narrow>
  <slot />
</Layout>
