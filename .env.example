OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- scripts/update_prices.py alerts (configure Discord and/or Telegram) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
